# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.
DB_PASSWORD=change-moi-mot-de-passe-long
# Générer avec : openssl rand -base64 48
JWT_SECRET=change-moi-secret-de-48-caracteres-minimum
# Le compte créé avec cette adresse devient admin
ADMIN_EMAIL=jonathan6wando@gmail.com
# Adresses publiques (en production : https://academy.mondomaine.sn et https://api.mondomaine.sn/api)
# WEB_URL sert aussi à construire les liens envoyés par e-mail
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api
# Envoi des e-mails (vérification, mot de passe oublié). Laisser SMTP_HOST vide en développement :
# les liens sont alors écrits dans le journal de l'API (docker compose logs api).
# Brevo : SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, identifiants SMTP du compte Brevo
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Saint Stack Academy <no-reply@mondomaine.sn>
