# Production (VPS) : copier ce fichier en .env sur le serveur, le remplir, puis : chmod 600 .env
# Ne jamais commiter .env ni l'envoyer par message.
# Docker Compose remplace ${DOMAINE} par sa valeur dans les lignes suivantes : il suffit de remplir DOMAINE.

# Nom de domaine du site, sans https:// ni / final (exemple : meredianstack.sn)
DOMAINE=
# Adresse publique du site : sert aux liens des e-mails et à l'autorisation CORS de l'API
WEB_URL=https://${DOMAINE}
# Adresse publique de l'API (Caddy envoie /api vers le service api) ; intégrée au site pendant la construction
API_URL=https://${DOMAINE}/api
# Adresse publique du site pour les images de partage (URL absolue) ; intégrée au site pendant la construction
NEXT_PUBLIC_SITE_URL=https://${DOMAINE}

# Mot de passe de la base PostgreSQL : à générer sur le serveur avec  openssl rand -base64 32
DB_PASSWORD=
# Secret des sessions (au moins 32 caractères, sinon l'API refuse de démarrer) : openssl rand -base64 48
JWT_SECRET=
# Le compte créé avec cette adresse devient administrateur
ADMIN_EMAIL=

# Envoi des e-mails (vérification d'adresse, mot de passe oublié) avec Brevo : identifiants SMTP du compte Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur des e-mails ; le domaine doit être validé dans Brevo (SPF, DKIM, DMARC)
SMTP_FROM=MeredianStack <no-reply@${DOMAINE}>
